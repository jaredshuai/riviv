<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="*" name="riviv" type="win32" />
  <description>riviv — image viewer</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- DPI awareness + Common-Controls v6 manifest (#79, #229). The 2016
       namespace is required for
       dpiAwareness (the 2005 one only knows the dpiAware element); the
       fallback list makes pre-1703 systems take System awareness — exactly
       the pre-#79 behavior (SetProcessDPIAware). The legacy dpiAware=true
       line below is the documented belt-and-suspenders for loaders that
       predate the 2016 element (both are honored, newer wins); today it is
       unreachable — the GetDpiForSystem import floors the OS at 1607,
       where dpiAwareness is already understood. The Common-Controls v6
       dependency below is verbatim from upstream's manifest (c-original/
       res/voidImageViewer.Manifest:5-9) and activates manifest-only —
       InitCommonControlsEx was already in place with upstream's flags, so
       v6 costs zero code and zero new DLL imports (#227 spike,
       docs/spikes/s-v6-chrome.md): the comctl-owned surfaces re-skin from
       the comctl32 5.82 classic chrome to v6 themes, the OS-drawn surfaces
       (menus, the common file dialog) stay byte-identical, and the single
       measured-metric drift is the playlist row height 25→28px (see README
       Differences). asInvoker above
       matches upstream's manifest (it is also the default when absent). -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, System</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="*" name="riviv" type="win32" />
  <description>riviv — image viewer</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Awareness-only manifest (#79). The 2016 namespace is required for
       dpiAwareness (the 2005 one only knows the dpiAware element); the
       fallback list makes pre-1703 systems take System awareness — exactly
       the pre-#79 behavior (SetProcessDPIAware). The legacy dpiAware=true
       line below is the documented belt-and-suspenders for loaders that
       predate the 2016 element (both are honored, newer wins); today it is
       unreachable — the GetDpiForSystem import floors the OS at 1607,
       where dpiAwareness is already understood. Deliberately NO
       Common-Controls v6 dependency: riviv has shipped without a manifest,
       i.e. on comctl32 5.82 classic chrome, and #79's zero-diff acceptance
       keeps that pixel-for-pixel (see README Differences). asInvoker above
       matches upstream's manifest (it is also the default when absent). -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, System</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
